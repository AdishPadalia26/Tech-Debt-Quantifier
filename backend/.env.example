# Database
DATABASE_URL=sqlite:///./tech_debt.db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
HYBRID_ESTIMATION_ENABLED=false

# Slack Integration (optional)
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_DEFAULT_CHANNEL=#tech-debt

# Jira Integration (optional)
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=TD

# GitHub OAuth (for login, optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
JWT_SECRET=change-this-to-a-random-secret
JWT_ALG=HS256

# Frontend origin (for OAuth redirect)
FRONTEND_ORIGIN=http://localhost:3000

# Cost estimation
HOURLY_RATE=85