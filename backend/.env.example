# Database
DATABASE_URL=sqlite:///./tech_debt.db

# LLM Provider — set to "groq" (default), "nvidia_nim", "ollama", "openai", "huggingface_api"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_ID=llama-3.3-70b-versatile
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NIM_MODEL_ID=meta/llama-3.1-8b-instruct

# Ollama (local LLM, used as fallback when GROQ_API_KEY is missing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
HYBRID_ESTIMATION_ENABLED=false

# Slack Integration (optional)
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_DEFAULT_CHANNEL=#tech-debt

# Jira Integration (optional)
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=TD

# GitHub OAuth (for login, optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
JWT_SECRET=change-this-to-a-random-secret
JWT_ALG=HS256

# Frontend origin (for OAuth redirect)
FRONTEND_ORIGIN=http://localhost:3000

# Public base URL used in Slack notifications (set to your deployed URL in production)
PUBLIC_BASE_URL=http://localhost:8000

# Cost estimation
HOURLY_RATE=85
ANALYSIS_TIMEOUT_SECONDS=800
ANALYSIS_CLONE_TIMEOUT_SECONDS=180
REPORT_TIMEOUT_SECONDS=180
OWNERSHIP_MAX_COMMITS=300

# Git clone depth for contributor/ownership analysis (increase for better accuracy on large repos)
GIT_CLONE_DEPTH=500
